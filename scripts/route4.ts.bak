/**
 * 第四区（31F–40F）可通关性：以 docs/zone3-end.json 为起点，按攻略（见 docs/research.md §16.6）在真实引擎上执行：
 *   32F 一上楼就被骑士队长伏击（强制战斗）→ 32F 祭坛（有钱就买；攻 / 防按「剩余怪物总伤害最小」选，攻击优先到 150 以秒双手剑士）
 *   → 33F 骑士剑 / 38F 骑士盾 / 宝石 → 39F「3 点」谜题只开 (3,1)(5,3) 拿瞬移 → 2F 小偷打通 35F 暗道绕过魔龙
 *   → 40F 用瞬移从入口 (9,10) 飞到 (1,0)，逐个打掉骑士队长的手下（此时没有先攻），再踩 (5,6) 触发剧情 → 41F。
 * 输出 docs/zone4-route.txt / docs/zone4-end.json。运行：npm run route4
 */
import fs from 'node:fs';
import { forecastBattle } from '../src/game/combat';
import { altarPrice } from '../src/game/scriptlib';
import type { SaveData } from '../src/game/state';
import { Planner } from './planner';

const env = (k: string, d: number) => Number(process.env[k] ?? d);
const save = JSON.parse(fs.readFileSync(process.env.R_START ?? 'docs/zone3-end.json', 'utf8')) as SaveData;
const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
const HOLD = process.env.R_HOLD === '0' ? [] : range(1, 20);
const PUZZLE39 = ['1,1', '5,1', '1,3', '3,3', '1,5', '3,5', '5,5'];
const flags0: Record<string, unknown> = {};
const pl: Planner = new Planner(save, {
  floors: range(1, 40),
  keyV: { yellow: env('R_KY', 40), blue: env('R_KB', 250), red: env('R_KR', 600) },
  goldV: env('R_GOLD', 1.2), gemMin: env('R_GEM', 60), toolV: 300,
  holdFloors: HOLD,
  safety: 1,
  valueFloors: range(31, 40),
  cap: env('R_CAP', 1500),
  gemScale: env('R_GS', 0.5),
  maxFrac: env('R_FRAC', 0.45),
  forbidDoor: (f, p) => f === 39 && PUZZLE39.includes(`${p.x},${p.y}`),
  // 40F 的军队留到瞬移之后再打；35F 魔龙、25F 大法师不打
  avoidMonster: (f, _p, m): boolean => m === 'magicDragon' || m === 'blackMagician' || (f === 40 && !flags0.fly40),
});
const g = pl.g;
const P = (x: number, y: number) => ({ x, y });
const MAXBUY = env('R_MAXBUY', 99);
let buys = 0;
let ok = true;
const step = async (r: Promise<boolean> | boolean) => { if (ok && !(await r)) ok = false; return ok; };

/** 祭坛：攻 / 防按第四区剩余怪物总伤害最小选择；攻击不到 150 时偏向攻击（攻略：150 攻秒双手剑士） */
async function altarIfRich(): Promise<boolean> {
  const t = Number(g.flags.altarTimes ?? 0);
  const price = altarPrice(t);
  if (g.hero.gold < price || buys >= MAXBUY) return false;
  const h = g.hero;
  const atkFirst = h.atk < env('R_ATK', 150) && process.env.R_ATKFIRST !== '0';
  const ra = pl.remaining({ ...h, atk: h.atk + 8 });
  const rd = pl.remaining({ ...h, def: h.def + 16 });
  const pick = atkFirst && ra <= rd * env('R_ATKBIAS', 1.6) ? 1 : ra < rd ? 1 : 2;
  const r = await pl.altar(32, P(9, 9), [pick]);
  if (r) buys++;
  return r;
}

pl.snapshot('起点（第三区路线终局，31F）');
await step(pl.reach(32, P(5, 9), '32F 骑士队长伏击（强制战斗）'));
await altarIfRich();
/** 攻略里程碑：可达且路上伤害不超过当前生命的 frac 时执行 */
const milestones: Array<{ name: string; done: () => boolean; f: number; p: { x: number; y: number }; frac: number }> = [
  // 33F 骑士剑（从剑左侧的花丛向右进入，绕开 (9,4) 的机关）——有了它才能破骑士（防 105）的防
  { name: '33F 骑士剑', done: () => g.hero.weapon === '骑士剑' || g.hero.atk >= 999, f: 33, p: P(9, 9), frac: env('R_SWF', 0.8) },
  { name: '38F 骑士盾', done: () => g.hero.shield === '骑士盾', f: 38, p: P(1, 6), frac: env('R_SHF', 0.8) },
];
async function tryMilestones(): Promise<boolean> {
  for (const m of milestones) {
    if (m.done()) continue;
    const d = pl.probe(m.f, m.p);
    if (d !== null && d < g.hero.hp * m.frac) return pl.reach(m.f, m.p, m.name);
  }
  return false;
}
for (let iter = 0; ok && iter < 400; iter++) {
  if (await altarIfRich()) continue;
  // 39F 谜题：只开 (3,1) 与 (5,3)
  if (!g.flags.puzzle39 && g.visited.has(39) && g.hero.keys.yellow >= 2 && !g.flags.try39) {
    g.flags.try39 = true;
    if ((await pl.bump(39, P(3, 1), '39F 谜题：开第 1 排中间的门')) && (await pl.bump(39, P(5, 3), '39F 谜题：开第 2 排右边的门'))) {
      await pl.reach(39, P(3, 3), '39F 拿瞬移');
      continue;
    }
  }
  // 2F 小偷：去 35F 打通绕过魔龙的暗道
  if (!g.flags.thief2b && g.visited.has(35) && !g.flags.try2 && (g.flags.try2 = true) && (await pl.bump(2, P(9, 10), '2F 小偷（去 35F 挖暗道）'))) continue;
  if (await tryMilestones()) continue;
  const n0 = pl.log.length;
  await pl.collect('收集', 1);
  if (pl.log.length > n0) continue;
  break;
}
pl.snapshot('第四区 31–39F 收集结束');
if (process.env.R_DEBUG) {
  const nodes = pl.search();
  for (const f of [31, 32, 33, 34, 35, 36, 37, 38, 39]) {
    const rows = g.floors[f].map((r, y) => r.map((c, x) => {
      const n = nodes.get(pl.key(f, P(x, y)));
      const ch = c.monster ? 'M' : c.door ? c.door[0] : c.item ? 'i' : c.npc ? 'n' : c.terrain === 'floor' ? '.' : c.terrain === 'wall' ? '#' : c.terrain[0];
      return n ? ch.toUpperCase() === ch && ch !== '.' && ch !== '#' ? ch : ch === '.' ? '*' : ch : ch === '.' ? ' ' : ch;
    }).join('')).join('\n');
    console.log(`--- ${f}F（* = 可达）\n${rows}`);
    g.floors[f].forEach((r, y) => r.forEach((c, x) => { if (c.monster) { const fc = forecastBattle({ ...g.hero, hp: 1e9 }, g.monsterDef(c.monster)); console.log(`   ${f}F (${x},${y}) ${g.monsterDef(c.monster).name} 伤害 ${fc.canAttack ? fc.damage : '破不了防'}${nodes.has(pl.key(f, P(x, y))) ? ' 可达 路伤 ' + nodes.get(pl.key(f, P(x, y)))!.dmg : ''}`); } }));
  }
}
// 40F：瞬移绕过红门与剧情点，逐个打掉手下，再踩剧情点
const troopDamage = () => {
  let t = 0;
  for (const [x, y] of [[4, 3], [3, 3], [2, 3], [6, 3], [7, 3], [8, 3], [3, 1], [2, 1], [1, 1], [7, 1], [8, 1], [9, 1]]) {
    const m = g.cell(P(x, y), 40)?.monster;
    if (m) t += forecastBattle({ ...g.hero, hp: 1e12 }, g.monsterDef(m)).damage;
  }
  return t;
};
pl.note(`  40F 手下逐个打的总伤害（无先攻）≈ ${troopDamage()}`);
if (ok && (g.hero.bag?.centerFly ?? 0) > 0) {
  await step(pl.reach(40, P(9, 10), '40F 入口'));
  if (ok) {
    g.useCenterFly();
    g.flags.fly40 = true;
    flags0.fly40 = true;
    pl.note(`→ 40F 使用瞬移：(9,10) → (${g.pos.x},${g.pos.y})`);
    await pl.collect('40F 手下', 40, (f) => f === 40);
  }
} else pl.note('  （没有瞬移：直接开红门踩剧情点，手下全部先攻）');
await step(pl.reach(40, P(5, 6), '40F 剧情：骑士队长'));
await pl.collect('40F 奖励', 20, (f) => f === 40);
await step(pl.reach(41, P(5, 9), '上楼到 41F'));
const end = pl.snapshot('第四区结束（到达 41F）');
const pass = ok && g.floorId === 41 && !!g.flags.knight40 && !g.dead;
pl.note(pass ? '✅ 第四区真实引擎执行通过' : '❌ 第四区未通过');
fs.writeFileSync('docs/zone4-route.txt', `第四区通关路线（scripts/route4.ts，真实引擎执行；参数 ${Object.entries(process.env).filter(([k]) => k.startsWith('R_')).map(([k, v]) => `${k}=${v}`).join(' ') || '默认'}）\n\n${pl.log.join('\n')}\n`);
if (pass) fs.writeFileSync('docs/zone4-end.json', JSON.stringify(g.serialize()));
console.log(pl.log.join('\n'));
console.log(end);
process.exitCode = pass ? 0 : 1;
